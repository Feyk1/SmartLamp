# Orchestrator (FastAPI) image for Fly.io.
#
# Build context: repository root (see fly.toml).
#   docker build -f infra/Dockerfile.orchestrator -t lamp-orchestrator .

FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl socat \
    && rm -rf /var/lib/apt/lists/*

COPY backend/pyproject.toml ./pyproject.toml
COPY backend/src ./src
COPY infra/orchestrator/entrypoint.sh ./entrypoint.sh

RUN pip install --no-cache-dir .

# OTA artifacts: mounted or copied into the deployment image.
# Without a volume, `GET /ota/latest` returns 409 until releases are published.
RUN mkdir -p /data/ota

ENV OTA_DIR=/data/ota

EXPOSE 8080
ENTRYPOINT ["./entrypoint.sh"]
