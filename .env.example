# ============================================================
# Smart Lamp Demo — Environment variables
# ============================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# NEVER commit .env. It is listed in .gitignore.
# ============================================================

# ------------------------------------------------------------
# Backend / Orchestrator
# ------------------------------------------------------------
# Secret used to sign/verify JWTs (HS256).
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production

# Static PIN for the Simulation Panel (demo).
SIM_PIN=2025

# Insecure mode allows http:// and ws:// during local development.
# Must be false in production (Fly.io).
INSECURE=true

# Local backend port.
BACKEND_PORT=8080

# Public WebSocket URL returned by the backend to the dashboard.
# Locally, the browser connects to the port published by Compose.
# For LAN access, the backend derives the URL from the Host header.
PUBLIC_WS_BASE=ws://localhost:8080

# Local demo: reuse the DEVICE_TOKEN instance on every POST.
REUSE_DEVICE_INSTANCE=true

# Schedules SQLite database (Compose overrides it to /data/schedules.db).
SCHEDULES_DB=data/schedules.db

# Instance TTL (s) and dashboard heartbeat timeout (s).
INSTANCE_TTL_S=3600
HEARTBEAT_TIMEOUT_S=300

# JWT sessions (HS256) and in-memory rate limiting.
JWT_TTL_S=3600
# One-time WebSocket ticket (seconds).
WS_TICKET_TTL_S=30
DEVICE_RATE_LIMIT=50
INSTANCE_RATE_LIMIT=5
SIM_PIN_RATE_LIMIT=5

# Simulated onboarding: 3 off→on cycles of 1–10 s (5–10 s recommended)
# inside a 2-minute total window.
PROVISIONING_DELAY_S=1.5
PROVISIONING_CYCLES=3
PROVISIONING_OFF_ON_MIN_S=1
PROVISIONING_OFF_ON_MAX_S=10
PROVISIONING_CYCLE_TOTAL_S=120

# Wi-Fi credentials: SQLite + AES-256-GCM.
# PROVISIONING_KEY is 32 bytes as hex; if empty it is derived from JWT_SECRET
# (acceptable for the demo, not for production).
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
PROVISIONING_DB=data/provisioning.db
PROVISIONING_KEY=
# Network seeded when an instance is created; empty disables the seed.
PROVISIONING_SEED_SSID=Casa-Demo
# Optional; if empty a random password is generated for the seed.
# PROVISIONING_SEED_PASSWORD=
# Initial whitelist and toggle to accept any SSID.
PROVISIONING_NETWORKS=Casa-Demo,Lab,Guest
PROVISIONING_ALLOW_ANY=false
PROVISIONING_FAILURE_DELAY_S=0.8
PROVISIONING_TIMEOUT_S=3

# CORS allowed origins (comma-separated; * locally).
DASHBOARD_ORIGINS=*

# Directory containing .ota artifacts served by the backend (local).
OTA_DIR=firmware/releases

# Orchestration: "local" (Compose) or "fly" (App + Machine per visit).
INSTANCE_MODE=local
PUBLIC_HTTP_BASE=http://localhost:8080

# ------------------------------------------------------------
# Fly.io (only needed for deployment, not for local development)
# ------------------------------------------------------------
# Organization token (create/destroy Apps and Machines).
# Generate with: fly tokens create org
FLY_ORG_TOKEN=

# Fly.io organization slug.
FLY_ORG_SLUG=personal

# Orchestrator App name.
FLY_ORCHESTRATOR_APP=lamp-demo-orchestrator

# Base App name for instances.
FLY_INSTANCE_BASE_APP=lamp-instance-base

# Region and image for ephemeral instances.
FLY_REGION=iad
FLY_IMAGE_TAG=latest

# ------------------------------------------------------------
# OTA (signing and encryption)
# ------------------------------------------------------------
# AES-256 key as hex (64 characters).
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
OTA_AES_KEY=

# Ed25519 private key as hex (64 characters).
# Generate with: python3 tools/generate_keys.py
OTA_SIGNING_KEY=

# Public key path (committed to the repository).
OTA_PUBLIC_KEY_PATH=keys/ota_public.pem

# ------------------------------------------------------------
# Firmware / Instance (injected by the orchestrator)
# ------------------------------------------------------------
# DO NOT fill these manually in production.
# The orchestrator injects them when creating a Machine.
DEVICE_TOKEN=
ORCH_WS_URL=ws://localhost:8080/ws/device
IDLE_TIMEOUT_S=300

# Fallback public serial (not a secret) used only when DEVICE_IDENTITY_PATH is
# unset. With an identity file, the driver uses the provisioned serial instead.
DEVICE_SERIAL=
# Stable device id used by the firmware and as the serial fallback.
DEVICE_ID=lamp-8f2a
# Persistent identity file (simulated OTP). It is written once on first boot
# and left read-only; factory reset and firmware reflash do not erase it.
DEVICE_IDENTITY_PATH=/var/lib/lamp/device_identity.txt
# Factory-programming values used only when the identity file is created.
# Empty PROVISION_WEEK uses the current ISO week (YYWW); empty PROVISION_ID
# uses /dev/urandom.
PROVISION_LOT=LA
PROVISION_WEEK=
PROVISION_ID=

# ------------------------------------------------------------
# Frontend (build-time)
# ------------------------------------------------------------
# Backend URL used by the dashboard. If it is localhost, the frontend uses
# the page host with port 8080 automatically (LAN).
PUBLIC_ORCHESTRATOR_URL=http://localhost:8080

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
LOG_LEVEL=INFO
